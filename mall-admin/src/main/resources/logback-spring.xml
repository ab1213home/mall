<configuration scan="true" scanPeriod="60 seconds">
    <!-- 日志输出路径 -->
<!--    <property name="LOG_PATH" value="./logs" />-->
    <springProperty name="LOG_PATH" source="mall.logging.location" defaultValue="./logs"/>
<!--    <springProfile name="dev">-->
<!--        <property name="log.path" value="/dev/logs" />-->
<!--    </springProfile>-->
<!--    <springProfile name="prod">-->
<!--        <property name="log.path" value="/prod/logs" />-->
<!--    </springProfile>-->
    <!-- 定义日志输出格式 -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n%ex{20}"/>
    <!-- 异步队列深度（默认256） -->
    <property name="ASYNC_QUEUE_SIZE" value="512" />

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 文件输出 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/mall.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/mall-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <compressionMode>gzip</compressionMode>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 异步文件输出 -->
    <appender name="FILE_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <!-- 异步队列容量 -->
        <queueSize>${ASYNC_QUEUE_SIZE}</queueSize>
        <!-- 队列剩余20%时丢弃TRACE/DEBUG日志 -->
        <discardingThreshold>20</discardingThreshold>
        <!-- 包含调用方法信息（轻微性能损耗） -->
        <includeCallerData>false</includeCallerData>
        <!-- 绑定同步文件输出 -->
        <appender-ref ref="FILE" />
    </appender>


    <!-- 根日志配置：控制台 + 文件 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE_ASYNC" />
    </root>

    <!-- 针对 Spring Boot 启动错误细化日志 -->
    <logger name="org.springframework.boot" level="WARN" />
</configuration>